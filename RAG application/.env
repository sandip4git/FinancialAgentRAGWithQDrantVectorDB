# Copy to .env and fill in values

# Vector DB backend: qdrant (recommended local) or pinecone
VECTOR_DB=qdrant

# Qdrant (local container)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=financials-index

# Pinecone local (optional; if you run a local-compatible image)
PINECONE_HOST=localhost
PINECONE_PORT=8080
PINECONE_INDEX=financials-index

# Embeddings: sentence-transformers model name
# Examples: intfloat/e5-base-v2 or nomic-ai/nomic-embed-text-v1.5
EMBEDDING_MODEL=intfloat/e5-base-v2

# Azure OpenAI (LLM)
AZURE_OPENAI_API_KEY=<<your-api-key>>
AZURE_OPENAI_ENDPOINT=https://<<your-end-point>>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=o4-mini-3

# Ingestion / Chunking A/B config
# Mode can be "recursive" or "semantic"
CHUNKING_MODE=semantic
# Recursive chunking params
CHUNK_SIZE=4400
CHUNK_OVERLAP=400
# Semantic chunking param (LangChain SemanticChunker threshold)
SEMANTIC_THRESHOLD=0.7

# Tag an ingestion run for A/B comparisons
# If not set, the app will generate a UUID at runtime
RUN_ID=rec_4400_400_v1

# Evaluation harness configuration
# Define two runs to compare (by run_id or strategy)
EVAL_RUN_A=rec_4400_400_v1
EVAL_RUN_B=sem_thr0_7_v1
